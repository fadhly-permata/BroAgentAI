{
  "apiVersion": 1,
  "id": "arena",
  "name": "Arena",
  "version": "0.1.0",
  "author": "BroAgentAI",
  "description": "LMArena web chat (experimental selector defaults)",
  "homepage": "https://lmarena.ai/",
  "matches": [
    "https://lmarena.ai/*"
  ],
  "status": "experimental",
  "icon": "icon.svg",
  "verified": "Not verified against the live site or a local fixture. Conservative best-effort selectors; check and adjust them on the actual page before relying on this plugin.",
  "selectors": {
    "composer": "textarea[placeholder], div[contenteditable='true']",
    "assistantMessage": "[data-message-role='assistant'], .markdown",
    "messageKeyFallback": true
  }
}
