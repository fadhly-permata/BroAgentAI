{
  "apiVersion": 1,
  "id": "stackoverflow",
  "name": "Stack Overflow AI Assist",
  "version": "1.0.0",
  "author": "BroAgentAI",
  "description": "Stack Overflow AI Assist web interface",
  "homepage": "https://stackoverflow.com/ai-assist",
  "icon": "icon.svg",
  "matches": [
    "https://stackoverflow.com/ai-assist*"
  ],
  "status": "experimental",
  "selectors": {
    "composer": "textarea, [contenteditable=\"true\"]",
    "submit": "",
    "assistantMessage": "[data-testid*=\"assistant\"], [data-message-role=\"assistant\"], [class*=\"assistant-message\"], [class*=\"ai-response\"]",
    "userMessage": "[data-testid*=\"user-message\"], [data-message-role=\"user\"], [class*=\"user-message\"]",
    "generating": "button[aria-label*=\"Stop\"], button[data-testid*=\"stop\"]"
  }
}