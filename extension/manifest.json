{
  "manifest_version": 3,
  "name": "BroAgentAI",
  "version": "0.2.0",
  "description": "BroAgentAI extension",
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "BroAgentAI - Buka Side Panel"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "nativeMessaging",
    "notifications",
    "scripting",
    "userScripts"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
