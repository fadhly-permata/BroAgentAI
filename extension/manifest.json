{
  "manifest_version": 3,
  "name": "BrowserAgent",
  "version": "0.1.0",
  "description": "BrowserAgent extension",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "BrowserAgent - Buka Side Panel"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "permissions": ["storage", "sidePanel", "tabs"]
}
