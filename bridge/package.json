{
  "name": "@broagentai/bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node22 --sourcemap --clean --dts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.mts",
    "bench": "node --experimental-strip-types src/shell.bench.mts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-pty": "^1.1.0"
  }
}
